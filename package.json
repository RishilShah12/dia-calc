{
  "name": "dia-calc",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @dia-calc/db",
    "db:studio": "turbo -F @dia-calc/db db:studio",
    "deploy": "turbo run deploy -F @dia-calc/infra",
    "deploy:prod": "turbo run deploy:prod -F @dia-calc/infra",
    "destroy": "turbo run destroy -F @dia-calc/infra",
    "dev": "turbo run dev",
    "dev:native": "turbo run dev -F native",
    "dev:server": "turbo run dev -F server",
    "dev:web": "turbo run dev -F web",
    "fix": "ultracite fix",
    "native:apk": "pnpm --filter native build:apk"
  },
  "dependencies": {
    "@dia-calc/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/workers-types": "catalog:",
    "@dia-calc/config": "workspace:*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "ultracite": "7.10.3"
  },
  "packageManager": "pnpm@11.21.0"
}
