{
  "name": "dia-calc",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:generate": "turbo run db:generate -F @dia-calc/db",
    "deploy": "turbo run deploy -F @dia-calc/infra",
    "destroy": "turbo run destroy -F @dia-calc/infra",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@dia-calc/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@cloudflare/workers-types": "catalog:",
    "@dia-calc/config": "workspace:*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4"
  },
  "packageManager": "pnpm@11.21.0"
}
