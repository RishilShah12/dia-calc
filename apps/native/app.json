{
  "expo": {
    "scheme": "dia-calc",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "web": {
      "bundler": "metro"
    },
    "name": "dia-calc",
    "slug": "dia-calc",
    "plugins": ["expo-font", "expo-apple-authentication"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.rishilshah.dia-calc",
      "usesAppleSignIn": true
    }
  }
}
